resource "aws_glue_catalog_database" "bmw_etl_database" {
  name        = "bmw_enterprise_etl"
  description = "AWS Glue Data Catalog database for the BMW Enterprise Batch ETL platform"
}


# ============================================================
# VEHICLE MASTER TABLE
# ============================================================

resource "aws_glue_catalog_table" "vehicle_master" {
  name          = "vehicle_master"
  database_name = aws_glue_catalog_database.bmw_etl_database.name
  table_type    = "EXTERNAL_TABLE"

  parameters = {
    classification = "parquet"
    type           = "parquet"
  }

  storage_descriptor {
    location      = "s3://bmw-enterprise-etl-navya-2026/processed/vehicle_master/"
    input_format  = "org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat"
    output_format = "org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat"

    ser_de_info {
      serialization_library = "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"
    }

    columns {
      name = "vehicle_id"
      type = "string"
    }

    columns {
      name = "vin"
      type = "string"
    }

    columns {
      name = "model"
      type = "string"
    }

    columns {
      name = "model_year"
      type = "int"
    }

    columns {
      name = "fuel_type"
      type = "string"
    }

    columns {
      name = "region"
      type = "string"
    }

    columns {
      name = "manufacturing_date"
      type = "date"
    }
  }
}


# ============================================================
# SALES TABLE
# ============================================================

resource "aws_glue_catalog_table" "sales" {
  name          = "sales"
  database_name = aws_glue_catalog_database.bmw_etl_database.name
  table_type    = "EXTERNAL_TABLE"

  parameters = {
    classification = "parquet"
    type           = "parquet"
  }

  storage_descriptor {
    location      = "s3://bmw-enterprise-etl-navya-2026/processed/sales/"
    input_format  = "org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat"
    output_format = "org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat"

    ser_de_info {
      serialization_library = "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"
    }

    columns {
      name = "sale_id"
      type = "string"
    }

    columns {
      name = "vehicle_id"
      type = "string"
    }

    columns {
      name = "dealer_id"
      type = "string"
    }

    columns {
      name = "customer_id"
      type = "string"
    }

    columns {
      name = "sale_date"
      type = "date"
    }

    columns {
      name = "model"
      type = "string"
    }

    columns {
      name = "region"
      type = "string"
    }

    columns {
      name = "price"
      type = "double"
    }

    columns {
      name = "quantity"
      type = "int"
    }

    columns {
      name = "revenue"
      type = "double"
    }
  }
}


# ============================================================
# MAINTENANCE TABLE
# ============================================================

resource "aws_glue_catalog_table" "maintenance" {
  name          = "maintenance"
  database_name = aws_glue_catalog_database.bmw_etl_database.name
  table_type    = "EXTERNAL_TABLE"

  parameters = {
    classification = "parquet"
    type           = "parquet"
  }

  storage_descriptor {
    location      = "s3://bmw-enterprise-etl-navya-2026/processed/maintenance/"
    input_format  = "org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat"
    output_format = "org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat"

    ser_de_info {
      serialization_library = "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"
    }

    columns {
      name = "service_id"
      type = "string"
    }

    columns {
      name = "vehicle_id"
      type = "string"
    }

    columns {
      name = "dealer_id"
      type = "string"
    }

    columns {
      name = "service_date"
      type = "date"
    }

    columns {
      name = "service_type"
      type = "string"
    }

    columns {
      name = "odometer"
      type = "int"
    }

    columns {
      name = "parts_cost"
      type = "double"
    }

    columns {
      name = "labour_cost"
      type = "double"
    }

    columns {
      name = "failure_code"
      type = "string"
    }

    columns {
      name = "total_service_cost"
      type = "double"
    }
  }
}


# ============================================================
# DEALER TABLE
# ============================================================

resource "aws_glue_catalog_table" "dealer" {
  name          = "dealer"
  database_name = aws_glue_catalog_database.bmw_etl_database.name
  table_type    = "EXTERNAL_TABLE"

  parameters = {
    classification = "parquet"
    type           = "parquet"
  }

  storage_descriptor {
    location      = "s3://bmw-enterprise-etl-navya-2026/processed/dealer/"
    input_format  = "org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat"
    output_format = "org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat"

    ser_de_info {
      serialization_library = "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe"
    }

    columns {
      name = "dealer_id"
      type = "string"
    }

    columns {
      name = "dealer_name"
      type = "string"
    }

    columns {
      name = "city"
      type = "string"
    }

    columns {
      name = "region"
      type = "string"
    }

    columns {
      name = "capacity"
      type = "int"
    }

    columns {
      name = "rating"
      type = "double"
    }
  }
}