# ──────────────────────────────────────────────────────────────────────────────
# terraform.tfvars.example — BMW Data Quality & Governance Platform
# Participant 12 | Pod D
#
# Copy this file to terraform.tfvars and fill in your own values.
# DO NOT commit terraform.tfvars to source control (it's in .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

aws_region   = "eu-central-1"
environment  = "dev"
project_name = "bmw-data-quality"

# Leave empty to auto-generate: bmw-data-quality-<account_id>
s3_bucket_name = ""

# Set to true only in dev/test — allows bucket deletion even if it has objects
s3_force_destroy = false

# Versioning keeps previous object versions (recommended for prod)
s3_versioning_enabled = true

# Move quarantine objects to Glacier after 90 days
s3_lifecycle_quarantine_days = 90

# Delete log objects after 1 year
s3_lifecycle_logs_days = 365

# CloudWatch
cloudwatch_retention_days   = 90
alarm_low_quality_threshold = 70  # Alert when quality score < 70
